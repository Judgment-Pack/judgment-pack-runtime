{
  "specVersion": "0.5.0",
  "id": "https://example.com/packs/advice-core050",
  "version": "1.0.0",
  "title": "Pack-design analysis over an evaluation form",
  "decision": {
    "intent": "Route a synthetic request.",
    "question": "Accept or refer the request?"
  },
  "extensions": {
    "org.judgmentpack.annotations": {
      "owner": "intake",
      "areas": ["routing", "tiers"]
    }
  },
  "valueSets": [
    {
      "id": "kinds",
      "description": "Request kinds in scope.",
      "entries": [
        {"value": "intake"},
        {"value": "renewal", "description": "A renewal.", "extensions": {"org.judgmentpack.annotations": {"note": "second"}}}
      ]
    },
    {
      "id": "tiers",
      "entries": [
        {"value": "gold"},
        {"value": "silver"}
      ]
    },
    {
      "id": "regions",
      "entries": [
        {"value": "us"}
      ]
    },
    {
      "id": "unused",
      "entries": [
        {"value": "never-referenced"}
      ]
    }
  ],
  "applicability": {"op": "fact", "path": "/kind", "operator": "in", "valueSet": "kinds"},
  "outcomes": [
    {"id": "accept", "label": "Accept", "extensions": {"org.judgmentpack.annotations": {"category": "core"}}},
    {"id": "refer", "label": "Refer"}
  ],
  "rules": [
    {
      "id": "tiered",
      "description": "A listed tier is accepted.",
      "when": {"op": "fact", "path": "/tier", "operator": "in", "valueSet": "tiers"},
      "outcome": "accept",
      "onUnknown": "ignore",
      "extensions": {"org.judgmentpack.annotations": {"category": "core"}, "com.example.note": {"text": "kept"}}
    },
    {
      "id": "gold",
      "description": "Gold is accepted.",
      "when": {"op": "fact", "path": "/tier", "operator": "equals", "value": "gold"},
      "outcome": "accept",
      "onUnknown": "ignore",
      "extensions": {"org.judgmentpack.annotations": {"category": ["core", "duplicate"]}}
    },
    {
      "id": "contradiction",
      "description": "A listed tier that is not listed.",
      "when": {
        "op": "all",
        "conditions": [
          {"op": "fact", "path": "/tier", "operator": "in", "valueSet": "tiers"},
          {"op": "not", "condition": {"op": "fact", "path": "/tier", "operator": "in", "valueSet": "tiers"}}
        ]
      },
      "outcome": "refer",
      "onUnknown": "ignore"
    }
  ],
  "exceptions": [
    {
      "id": "blocked",
      "description": "A listed region escalates.",
      "when": {"op": "any", "conditions": [{"op": "fact", "path": "/region", "operator": "in", "valueSet": "regions"}]},
      "effect": "escalate",
      "onUnknown": "ignore"
    }
  ],
  "fallbackOutcome": "refer"
}
