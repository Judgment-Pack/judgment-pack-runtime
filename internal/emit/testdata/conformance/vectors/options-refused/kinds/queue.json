{
  "kindFormatVersion": "1.0.0",
  "id": "https://example.invalid/kinds/queue",
  "version": "1.2.0",
  "kind": "queue",
  "owner": "platform",
  "schema": {
    "type": "object",
    "required": [
      "retention"
    ],
    "additionalProperties": false,
    "properties": {
      "retention": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      },
      "password": {
        "type": "string"
      }
    }
  },
  "secrets": [
    "/password"
  ],
  "overlayable": [
    "/retention",
    "/password"
  ]
}
