{
  "specVersion": "0.2.0-draft",
  "id": "https://example.invalid/judgment-packs/branches",
  "version": "0.0.1",
  "title": "Branch coverage",
  "decision": {"intent": "Exercise every diagram branch.", "question": "Branches?"},
  "applicability": {
    "op": "all",
    "conditions": [
      {"op": "fact", "path": "/scope", "operator": "equals", "value": "in"},
      {"op": "evidence-present", "evidenceRequirement": "charter"}
    ]
  },
  "evidenceRequirements": [
    {"id": "charter", "description": "Scope charter.", "required": true, "kind": "document"},
    {"id": "sign-off", "description": "Cited but never tested by any condition.", "required": false, "kind": "attestation"}
  ],
  "outcomes": [
    {"id": "allow", "label": "Allow"},
    {"id": "deny", "label": "Deny"}
  ],
  "rules": [
    {
      "id": "allow-when-chartered",
      "when": {"op": "not", "condition": {"op": "evidence-present", "evidenceRequirement": "charter"}},
      "outcome": "deny",
      "onUnknown": "ignore"
    },
    {
      "id": "deny-on-flag",
      "when": {"op": "fact", "path": "/flag", "operator": "equals", "value": true},
      "outcome": "deny",
      "onUnknown": "escalate",
      "evidenceRequirementRefs": ["sign-off"]
    }
  ],
  "exceptions": [
    {
      "id": "quiet-period",
      "when": {"op": "fact", "path": "/period", "operator": "equals", "value": "quiet"},
      "effect": "suppress-rule",
      "targetRule": "deny-on-flag",
      "onUnknown": "ignore"
    },
    {
      "id": "board-hold",
      "when": {"op": "fact", "path": "/hold", "operator": "equals", "value": true},
      "effect": "escalate",
      "onUnknown": "escalate"
    }
  ],
  "escalation": {
    "triggers": ["conflict"]
  }
}
