{
  "specVersion": "0.2.0-draft",
  "id": "https://example.invalid/judgment-packs/rfc0016-credit-limit-tiers",
  "version": "0.1.0",
  "title": "Synthetic credit limit chosen from authored tiers",
  "description": "Invented content for specification testing; it authorizes nothing.",
  "decision": {
    "intent": "Exercise constant values under the specification's draft RFC 0016.",
    "question": "Which credit limit is granted?"
  },
  "outcomes": [
    {
      "id": "limit-high",
      "label": "Approve, high limit",
      "extensions": {
        "org.judgmentpack.outcome-values": {
          "creditLimit": { "type": "decimal", "constant": "10000" }
        }
      }
    },
    {
      "id": "limit-standard",
      "label": "Approve, standard limit",
      "extensions": {
        "org.judgmentpack.outcome-values": {
          "creditLimit": { "type": "decimal", "constant": "5000" }
        }
      }
    },
    { "id": "decline", "label": "Decline" }
  ],
  "rules": [
    {
      "id": "score-720-or-more",
      "description": "A score of 720 or more is granted the high limit.",
      "when": { "op": "fact", "path": "/applicant/score", "operator": "greater-than-or-equal", "value": "720" },
      "outcome": "limit-high",
      "onUnknown": "escalate"
    },
    {
      "id": "score-650-to-719",
      "description": "A score of 650 to 719 is granted the standard limit.",
      "when": {
        "op": "all",
        "conditions": [
          { "op": "fact", "path": "/applicant/score", "operator": "greater-than-or-equal", "value": "650" },
          { "op": "fact", "path": "/applicant/score", "operator": "less-than", "value": "720" }
        ]
      },
      "outcome": "limit-standard",
      "onUnknown": "escalate"
    }
  ],
  "fallbackOutcome": "decline",
  "metadata": {
    "requiredExtensions": ["org.judgmentpack.outcome-values"]
  }
}
