# Release-pinned artifacts are verified byte-for-byte and must never undergo
# checkout-time line-ending conversion.
internal/artifacts/jps/** -text

# This exact upstream carrier vector intentionally ends with trailing whitespace.
internal/artifacts/jps/0.3.0/cases/carrier/trailing-whitespace.json -whitespace

# The gateway's witness vectors are a byte-for-byte copy held to a lock of
# their digests, and a vector's files are its bytes exactly.
internal/audit/testdata/witness/** -text

# A trail the v0.30.0 writer wrote, compared byte for byte with what the
# writer composes today.
internal/audit/testdata/trail-v0.30.0.jsonl -text
internal/cli/testdata/*.golden.* -text

# Pinned dialect contract and independent vectors have exact upstream checksums.
internal/dialect/testdata/** -text

# Pinned policy prototype files have exact upstream checksums.
internal/policy/prototype/** -text

# Candidate schemas, provenance, examples and vectors also retain exact bytes.
internal/policy/candidate/** -text

# Official independently released Policy draft resources retain exact bytes.
internal/policy/official/** -text

# The served authoring schema has a byte digest on every platform.
internal/dialect/version2.schema.json -text

# Independently pinned retained-column release resources retain exact bytes.
internal/dialect/retained-column/official/** -text
