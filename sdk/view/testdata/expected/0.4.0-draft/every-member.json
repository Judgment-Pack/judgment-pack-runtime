{
  "digest": "sha256:e163016dd5e9e3c1cffd7c3e758ed4f1838a7937db816a7c103973e3f7c4adf4",
  "pack": {
    "applicability": {
      "conditions": [
        {"op": "fact", "operator": "equals", "path": "/request/kind", "value": "purchase"},
        {"op": "fact", "operator": "equals", "path": "/request/kind", "value": "lease"}
      ],
      "op": "any"
    },
    "decision": {
      "extensions": {"com.example.decision-note": {"a": [1, "1", true, null], "b": 2}},
      "intent": "Carry every member the schema allows at least once.",
      "question": "Does the view carry every member?"
    },
    "description": "Invented content for the pack view tests; it authorizes nothing.",
    "escalation": {
      "extensions": {"com.example.sla": {"hours": 24}},
      "message": "Review the purchase by hand.",
      "routes": [
        {"target": {"kind": "queue", "name": "Purchasing queue"}, "triggers": ["unknown", "no-match"]},
        {"target": {"kind": "system", "name": "Conflict resolver"}}
      ],
      "triggers": ["unknown", "conflict", "no-match"]
    },
    "evidenceRequirements": [
      {
        "description": "A receipt for the purchase.",
        "extensions": {"com.example.retention": "seven-years"},
        "id": "receipt",
        "kind": "document",
        "required": true
      },
      {"description": "A site visit record.", "id": "site-visit", "kind": "attestation", "required": false}
    ],
    "exceptions": [
      {
        "description": "An auditor hold declines.",
        "effect": "force-outcome",
        "extensions": {"com.example.exception-note": "audit"},
        "id": "auditor-hold",
        "onUnknown": "escalate",
        "outcome": "decline",
        "sourceRefs": ["policy"],
        "when": {"op": "fact", "operator": "not-equals", "path": "/request/hold", "value": false}
      },
      {
        "description": "A trusted vendor skips the limit rule.",
        "effect": "suppress-rule",
        "id": "trusted-vendor",
        "onUnknown": "ignore",
        "targetRule": "over-limit",
        "when": {"op": "fact", "operator": "equals", "path": "/vendor/trusted", "value": true}
      },
      {
        "description": "A new vendor escalates.",
        "effect": "escalate",
        "id": "new-vendor",
        "onUnknown": "ignore",
        "when": {"op": "fact", "operator": "in", "path": "/vendor/tier", "value": ["new", 0, false, null]}
      }
    ],
    "extensions": {
      "com.example.top-level": {"y": [2, 3], "z": 1},
      "org.judgmentpack.annotations": {"domain": "purchasing", "tags": ["limits"]}
    },
    "fallbackOutcome": "decline",
    "id": "https://example.invalid/judgment-packs/view-every-member",
    "metadata": {
      "authors": ["Purchasing team", "Finance team"],
      "createdAt": "2026-02-01T09:30:00Z",
      "extensions": {"com.example.metadata-note": "draft"},
      "license": "CC-BY-4.0",
      "requiredExtensions": ["com.example.rule-owner"],
      "reviews": [
        {"disposition": "approved", "note": "Limits match the policy.", "reviewedAt": "2026-02-02T10:00:00Z", "reviewer": "Controller"},
        {"disposition": "rejected", "reviewedAt": "2026-02-03T11:00:00Z", "reviewer": "Auditor"}
      ]
    },
    "outcomes": [
      {
        "description": "The purchase may proceed.",
        "extensions": {"com.example.colour": "green", "org.judgmentpack.annotations": {"tier": "green"}},
        "id": "approve",
        "label": "Approve"
      },
      {"extensions": {"org.judgmentpack.annotations": {"tier": "amber"}}, "id": "refer", "label": "Refer"},
      {"id": "decline", "label": "Decline"}
    ],
    "profile": "base",
    "rules": [
      {
        "description": "An amount over the limit with a receipt is referred.",
        "evidenceRequirementRefs": ["receipt", "site-visit"],
        "extensions": {
          "com.example.rule-owner": {"since": 2024, "team": "finance"},
          "org.judgmentpack.annotations": {"category": ["limits", "approval"], "review-cycle": "monthly"}
        },
        "id": "over-limit",
        "onUnknown": "escalate",
        "outcome": "refer",
        "rationale": "Section 4.2 sets the limit.",
        "sourceRefs": ["policy"],
        "when": {
          "conditions": [
            {"op": "fact", "operator": "greater-than-or-equal", "path": "/request/amount", "value": "1000.00"},
            {"evidenceRequirement": "receipt", "op": "evidence-present"},
            {"condition": {"op": "literal", "value": false}, "op": "not"}
          ],
          "op": "all"
        }
      },
      {
        "description": "A small purchase is approved.",
        "id": "small",
        "onUnknown": "ignore",
        "outcome": "approve",
        "when": {"op": "fact", "operator": "in", "path": "/request/category", "valueSet": "small-categories"}
      }
    ],
    "sources": [
      {
        "citation": {"excerpt": "Purchases over the limit need approval.", "location": "Section 4.2"},
        "extensions": {"com.example.source-owner": "finance"},
        "id": "policy",
        "locator": {"kind": "repository", "value": "policies/purchasing"},
        "publishedAt": "2026-01-15",
        "publisher": "Finance",
        "rights": "Internal use only.",
        "title": "Purchasing policy"
      }
    ],
    "specVersion": "0.4.0-draft",
    "title": "Every member of a staged 0.4.0-draft pack",
    "valueSets": [
      {
        "description": "Categories a small purchase may be in.",
        "entries": [
          {
            "description": "Paper and pens.",
            "extensions": {"org.judgmentpack.annotations": {"code": "S1", "owners": ["office"]}},
            "value": "stationery"
          },
          {"extensions": {"org.judgmentpack.annotations": {"label": "Caf\u00e9 \ufff9menu\ufffb"}}, "value": "caf\u00e9"},
          {"value": {"unit": 1.50}}
        ],
        "id": "small-categories"
      },
      {"entries": [{"value": 0}], "id": "unused"}
    ],
    "version": "2.0.0"
  },
  "viewVersion": "1"
}
