{
  "digest": "sha256:0dacc1d58069a389f7a8e3d963d689814a7f81e1d6b30175ecf875a6d40569c9",
  "pack": {
    "applicability": {"op": "fact", "operator": "equals", "path": "/expense/type", "value": "employee-expense"},
    "decision": {
      "intent": "Determine whether an employee expense may be automatically approved, rejected, or sent to a human reviewer.",
      "question": "What approval path should this expense follow?"
    },
    "description": "Research example for deciding whether an employee expense may be automatically approved.",
    "escalation": {
      "message": "Review the expense, cited policy, missing evidence, and conflicting rules.",
      "target": {"kind": "human-role", "name": "Finance reviewer"},
      "triggers": ["not-applicable", "missing-required-evidence", "unknown", "conflict", "no-match"]
    },
    "evidenceRequirements": [
      {"description": "An itemized receipt for the expense.", "id": "receipt", "kind": "document", "required": true},
      {"description": "A valid cost-center identifier.", "id": "cost-center", "kind": "fact", "required": true}
    ],
    "exceptions": [
      {
        "description": "An expense connected to an active investigation requires human review.",
        "effect": "force-outcome",
        "id": "active-investigation",
        "onUnknown": "escalate",
        "outcome": "manual-review",
        "when": {"op": "fact", "operator": "equals", "path": "/expense/activeInvestigation", "value": true}
      }
    ],
    "extensions": {"org.judgmentpack.annotations": {"domain": "finance", "review-cycle": "quarterly"}},
    "fallbackOutcome": "manual-review",
    "id": "https://example.com/judgment-packs/expense-approval",
    "metadata": {
      "authors": ["Judgment Pack Specification contributors"],
      "createdAt": "2026-07-22T00:00:00Z",
      "license": "Apache-2.0"
    },
    "outcomes": [
      {
        "description": "The evidence and declared rules support automatic approval.",
        "extensions": {"org.judgmentpack.annotations": {"path": "automatic"}},
        "id": "approve",
        "label": "Approve"
      },
      {
        "description": "An accountable finance reviewer must decide.",
        "extensions": {"org.judgmentpack.annotations": {"path": "human"}},
        "id": "manual-review",
        "label": "Manual review"
      },
      {
        "description": "The expense falls in a prohibited category.",
        "extensions": {"org.judgmentpack.annotations": {"path": "automatic"}},
        "id": "reject",
        "label": "Reject"
      }
    ],
    "rules": [
      {
        "description": "Reject expenses in a prohibited category.",
        "evidenceRequirementRefs": ["receipt", "cost-center"],
        "extensions": {"org.judgmentpack.annotations": {"category": ["policy", "prohibition"]}},
        "id": "prohibited-category",
        "onUnknown": "escalate",
        "outcome": "reject",
        "rationale": "The example policy prohibits these categories.",
        "sourceRefs": ["expense-policy"],
        "when": {"op": "fact", "operator": "in", "path": "/expense/category", "valueSet": "prohibited-categories"}
      },
      {
        "description": "Send expenses above the declared threshold to finance review.",
        "evidenceRequirementRefs": ["receipt", "cost-center"],
        "extensions": {"org.judgmentpack.annotations": {"category": "threshold"}},
        "id": "large-expense",
        "onUnknown": "escalate",
        "outcome": "manual-review",
        "rationale": "The example policy requires finance review above 5000.",
        "sourceRefs": ["expense-policy"],
        "when": {"op": "fact", "operator": "greater-than", "path": "/expense/amount", "value": "5000"}
      },
      {
        "description": "Approve a supported ordinary expense at or below the threshold.",
        "evidenceRequirementRefs": ["receipt", "cost-center"],
        "extensions": {"org.judgmentpack.annotations": {"category": "threshold", "review-cycle": "monthly"}},
        "id": "ordinary-expense",
        "onUnknown": "escalate",
        "outcome": "approve",
        "rationale": "Ordinary supported expenses may follow the automatic path.",
        "sourceRefs": ["expense-policy"],
        "when": {
          "conditions": [
            {"op": "fact", "operator": "less-than-or-equal", "path": "/expense/amount", "value": "5000"},
            {"condition": {"op": "fact", "operator": "in", "path": "/expense/category", "valueSet": "prohibited-categories"}, "op": "not"},
            {"evidenceRequirement": "receipt", "op": "evidence-present"},
            {"evidenceRequirement": "cost-center", "op": "evidence-present"}
          ],
          "op": "all"
        }
      }
    ],
    "sources": [
      {
        "citation": {
          "excerpt": "Expenses above 5000 require finance review. Prohibited categories must be rejected.",
          "location": "Section 4 \u2014 approval thresholds"
        },
        "id": "expense-policy",
        "locator": {"kind": "uri", "value": "https://example.com/policies/expenses"},
        "publishedAt": "2026-01-15",
        "publisher": "Example Corporation",
        "rights": "Example content; not an operational policy.",
        "title": "Example expense policy"
      }
    ],
    "specVersion": "0.4.0-draft",
    "title": "Expense approval",
    "valueSets": [
      {
        "description": "Expense categories the example policy prohibits.",
        "entries": [
          {
            "description": "A personal expense.",
            "extensions": {"org.judgmentpack.annotations": {"policy-section": "4.2"}},
            "value": "personal"
          },
          {
            "description": "Cash or an instrument redeemable as cash.",
            "extensions": {"org.judgmentpack.annotations": {"category": ["cash", "fraud-risk"], "policy-section": "4.3"}},
            "value": "cash-equivalent"
          }
        ],
        "id": "prohibited-categories"
      }
    ],
    "version": "0.2.0"
  },
  "viewVersion": "1"
}
