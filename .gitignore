/bin/*
!/bin/.gitkeep
/dist/
/jpack
/jpack.exe
/coverage.out
# Release-workflow staging for the OCI image build context (build/oci/Dockerfile).
/build/oci/bin/
/build/oci/metadata.json
/build/oci/CONFORMANCE.md
/build/oci/LICENSE
/build/oci/NOTICE
/build/oci/THIRD_PARTY_NOTICES
*.test
*.prof
.DS_Store
.idea/

# Ed25519 signing seeds. The gateway's keygen writes gateway.seed into whatever
# directory it is run from; a private key must never be committed.
*.seed

# Local AI-assistant configuration and state.
# .mcp.json is each contributor's client wiring, not project source; see docs/mcp-clients.md.
/.mcp.json
/.agent/
/.agents/
/.ai/
/.aider/
/.amazonq/
/.claude/
/.codeium/
/.codex/
/.continue/
/.copilot/
/.cursor/
/.gemini/
/.roo/
/.tabnine/
/.windsurf/

.vscode/*
!.vscode/tasks.json
